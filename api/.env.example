# Application
PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=zapzap
DB_PASS=zapzap
DB_NAME=zapzap

# JWT
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_strong_secret
